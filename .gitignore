# .gitignore
# Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.env/
.venv/
env/
venv/

# OS files
.DS_Store
Thumbs.db

# IDE/project files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Logs and runtime files
logs/
*.log
*.pid

# Cache and temp files
cache/
*.db
*.sqlite
*.bak
*.tmp

# Metadata and assets (user-generated, not source)
metadata/
assets/

# Sensitive or user-specific config
config.yml
.env
*.profile

# TMDb and other caches
cache/
cache/*
!/cache/.gitkeep

# Test output
test_output/
coverage/
htmlcov/
*.cover
.coverage
coverage.json
.pytest_cache/
.ruff_cache/

# Ignore Jupyter notebooks (if any)
*.ipynb
