TZ=UTC
PUID=10001
PGID=10001
# Unraid normally uses PUID=99 and PGID=100 (nobody:users).
METAFUSION_IMAGE=ghcr.io/ray-cys/metafusion:main

PLEX_URL=http://10.0.0.1:32400
PLEX_TOKEN=replace-with-plex-token
# Optional alternative: mount a protected file and set PLEX_TOKEN_FILE.
PLEX_TOKEN_FILE=
PLEX_LIBRARIES=Movies,TV Shows
TMDB_API_KEY=replace-with-tmdb-api-key
TMDB_API_KEY_FILE=
TMDB_LANGUAGE=en-US
TMDB_LANGUAGE_FALLBACK=zh,ja
TMDB_REGION=US

CONFIG_PATH=./config
KOMETA_HOST_PATH=./kometa
KOMETA_PATH=/kometa
RUN_MODE=kometa
METAFUSION_RUN=False
RUN_SCHEDULE=True
RUN_ON_START=False
RUN_TIMES=06:00,18:30
DRY_RUN=False
LOG_LEVEL=INFO

RUN_BASIC=True
RUN_ENHANCED=True
RUN_POSTER=True
RUN_SEASON=True
RUN_BACKGROUND=False
RUN_CLEANUP=False

MAX_CONCURRENCY=8
REQUEST_TIMEOUT=30
CONNECT_TIMEOUT=10
PLEX_TIMEOUT=10
PLEX_RETRIES=3
PLEX_RETRY_DELAY=1
SHUTDOWN_TIMEOUT=15
STOP_GRACE_PERIOD=20s
HEALTH_FAIL_ON_JOB_ERROR=False
HEALTH_MAX_HEARTBEAT_AGE=120
MAX_IMAGE_MB=25
ALLOW_AMBIGUOUS_EDITIONS=False
INCREMENTAL=True
FULL_SCAN_INTERVAL_HOURS=168
IMAGE_UPGRADE_DAYS=30
# Optional per-type overrides; blank values inherit IMAGE_UPGRADE_DAYS.
MOVIE_IMAGE_UPGRADE_DAYS=
SERIES_IMAGE_UPGRADE_DAYS=
SEASON_IMAGE_UPGRADE_DAYS=
TMDB_CACHE_ENABLED=True
TMDB_CACHE_TTL_HOURS=24
TMDB_CACHE_MAX_ENTRIES=5000
VALIDATE_OUTPUT=True
OUTPUT_BACKUP_COUNT=3

POSTER_MAX_WIDTH=2000
POSTER_MAX_HEIGHT=3000
POSTER_MIN_WIDTH=1000
POSTER_MIN_HEIGHT=1500
POSTER_PREFER_VOTE=5.0
POSTER_VOTE_RELAXED=3.5
POSTER_VOTE_THRESHOLD=5.0

SEASON_MAX_WIDTH=2000
SEASON_MAX_HEIGHT=3000
SEASON_MIN_WIDTH=1000
SEASON_MIN_HEIGHT=1500
SEASON_PREFER_VOTE=5.0
SEASON_VOTE_RELAXED=0.5
SEASON_VOTE_THRESHOLD=3.0

BG_MAX_WIDTH=3840
BG_MAX_HEIGHT=2160
BG_MIN_WIDTH=1920
BG_MIN_HEIGHT=1080
BG_PREFER_VOTE=5.0
BG_VOTE_RELAXED=3.5
BG_VOTE_THRESHOLD=5.0
