PLEX_URL=http://10.0.0.1:32400
PLEX_TOKEN=replace-with-your-plex-token
PLEX_LIBRARIES=Movies,TV Shows

TMDB_API_KEY=replace-with-your-tmdb-api-key
TMDB_LANGUAGE=en
TMDB_REGION=US
TMDB_LANGUAGE_FALLBACK=zh,ja

TZ=UTC
RUN_TIMES=06:00,18:30

# Keep this false for the long-running scheduler. Set it to true for a one-shot run.
METAFUSION_RUN=False
RUN_SCHEDULE=True

# Orphan cleanup is destructive and intentionally opt-in.
RUN_PROCESS=False
