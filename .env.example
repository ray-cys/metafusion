TZ=UTC
PUID=10001
PGID=10001

PLEX_URL=http://10.0.0.1:32400
PLEX_TOKEN=replace-with-plex-token
PLEX_LIBRARIES=Movies,TV Shows
TMDB_API_KEY=replace-with-tmdb-api-key
TMDB_LANGUAGE=en
TMDB_LANGUAGE_FALLBACK=zh,ja
TMDB_REGION=US

CONFIG_PATH=./config
KOMETA_HOST_PATH=./kometa
RUN_MODE=kometa
METAFUSION_RUN=False
RUN_SCHEDULE=True
RUN_TIMES=06:00,18:30
DRY_RUN=False
LOG_LEVEL=INFO

RUN_BASIC=True
RUN_ENHANCED=True
RUN_POSTER=True
RUN_SEASON=True
RUN_BACKGROUND=False
RUN_PROCESS=False

MAX_CONCURRENCY=8
REQUEST_TIMEOUT=30
CONNECT_TIMEOUT=10
MAX_IMAGE_MB=25
ALLOW_AMBIGUOUS_EDITIONS=False
